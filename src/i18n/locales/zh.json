  "lore": {
    "title": "编年史",
    "locked": "未知的编年史",
    "locked_desc": "到达 {{biome}} 以解锁此条目。",
    "entries": {
      "verdant_echo_1": {
        "title": "第一次日食",
        "content": "在光明的暴政之前，虚空是一个安静的摇篮。直到第一颗星星点燃，撕裂了存在的黑暗结构，平衡才被打破。"
      },
      "verdant_echo_2": {
        "title": "绿色誓约",
        "content": "回音森林是虚空退去后第一片绽放的生机之土。在这里，古老的循环形成了它们未被打破的契约。"
      },
      "verdant_echo_3": {
        "title": "初绽",
        "content": "在森林的中心矗立着母树，其根部直接饮用原始地脉。"
      },
      "azure_spire_1": {
        "title": "印记之战",
        "content": "印记之战染红了大地。秩序试图以绝对的律法约束地脉，而暗影则试图将其解开，化为混乱。"
      },
      "azure_spire_2": {
        "title": "引导者之塔",
        "content": "蔚蓝尖塔由第一批法师建筑师建立，他们是傲慢的远见者，试图刺穿领域之间的帷幕。"
      },
      "azure_spire_3": {
        "title": "星界天文台",
        "content": "在最高尖塔的顶点是宏伟的太阳系仪，它不仅绘制星星，还绘制了奥术能量流。"
      },
      "twilight_rift_1": {
        "title": "青色火焰",
        "content": "奥术大师最终发现，魔法不是一种可以消耗的资源，而是与宇宙的生动对话。"
      },
      "twilight_rift_2": {
        "title": "裂隙开启",
        "content": "在暮色裂隙处，现实的线条渐渐虚无。"
      },
      "twilight_rift_3": {
        "title": "窃窃私语的回声",
        "content": "那些在裂隙附近停留太久的人开始听到声音——不是鬼魂的声音，而是可能性的声音。"
      },
      "crimson_wake_1": {
        "title": "鲜血协约",
        "content": "当暗影派系最终被赶出地脉时，他们并没有安静地逃离。"
      },
      "crimson_wake_2": {
        "title": "军阀的王座",
        "content": "觉醒者的黑曜石王座是一个拥有绝对权力的座位，但没有哪个军阀能在其拥抱中幸存超过一个季节。"
      },
      "crimson_wake_3": {
        "title": "红色的河流",
        "content": "觉醒的水域浓稠且带有金属味，承载着暗影的古老诅咒。"
      },
      "obsidian_heart_1": {
        "title": "虚空之心",
        "content": "黑曜石之心不是一个物理上的地方——它是一个宇宙创伤。"
      },
      "obsidian_heart_2": {
        "title": "虚空守护者的起源",
        "content": "如今被恐惧的虚空守护者曾经只是一个凡人——一个痴迷于绘制现实边缘地图的大师制图师。"
      },
      "obsidian_heart_3": {
        "title": "最后的回声",
        "content": "在核心结晶深处，有一颗完美无瑕的宝石，其中包含虚空守护者最初灵魂的被困精华。"
      }
    }
  },
