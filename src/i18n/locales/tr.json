  "lore": {
    "title": "Vakayiname",
    "locked": "Bilinmeyen Kayıt",
    "locked_desc": "Bu kaydı açmak için {{biome}} bölgesine ulaş.",
    "entries": {
      "verdant_echo_1": {
        "title": "İlk Tutulma",
        "content": "Işıktan önceki çağda, Boşluk bir düşman değil, bir beşikti. Denge ancak ilk yıldız doğduğunda bozuldu ve gölgeler acıkmayı öğrendi."
      },
      "verdant_echo_2": {
        "title": "Yeşil Pakt",
        "content": "Yeşil Yankı, Boşluğun Çekilmesinin ardından ilk yaşamı barındıran topraktı. Kadim düzenler paktlarını burada kurdu ve kendilerini yosunların altında derinlere uzanan ley hatlarına bağladı."
      },
      "azure_spire_1": {
        "title": "Mühürler Savaşı",
        "content": "Yüzyıllar boyunca Düzen ve Gölge, Ley hatlarının kontrolü için savaştı. Arkane yıldızlardan izledi, Doğa ise sadece çapraz ateşten sağ kurtuldu."
      },
      "azure_spire_2": {
        "title": "Kanal Ustaları'nın Kuleleri",
        "content": "Gök Kuleleri, alemler arasındaki perdeyi delmek isteyen ilk Büyücü-Mimarlar tarafından inşa edildi. Başardılar; ancak yanıt veren, bekledikleri değildi."
      },
      "twilight_rift_1": {
        "title": "Siyan Alevi",
        "content": "Arkane ustaları, büyünün harcanacak bir kaynak değil, kozmosla yapılan bir konuşma olduğunu keşfettiler. Siyan Alevi onların ilk başarılı yanıtıydı."
      },
      "twilight_rift_2": {
        "title": "Yarık Açıldı",
        "content": "Alacakaranlık Yarığı'nda gerçeklik çözülür. Akademisyenler bunun bir silah mı, kaza mı yoksa davet mi olduğunu tartışır. Çok yaklaşanlar değişmiş olarak geri döner — eğer dönerlerse."
      },
      "crimson_wake_1": {
        "title": "Kan Andı",
        "content": "Gölge fraksiyonu Ley hatlarından kovulduğunda kaçmadı. Geri çekilirken her şeyi yaktı; lanetli bir tohum serperek nehirleri bir nesil boyunca kırmızıya boyattı."
      },
      "crimson_wake_2": {
        "title": "Savaş Beyi'nin Tahtı",
        "content": "Kızıl İz, tartışmalı bir güçle yönetilir. Obsidyen tahta oturan her savaş beyi tam olarak bir mevsim boyunca onu elinde tuttu. Tahtın kendisi aç gibi görünüyor."
      },
      "obsidian_heart_1": {
        "title": "Boşluğun Kalbi",
        "content": "Obsidyen Kalp bir yer değil, bir yaradır. Son büyük ley hattı içe çöktüğünde toprak parçalanmadı. Kristalleşerek büyünün son anını sonsuza dek korudu."
      },
      "obsidian_heart_2": {
        "title": "Boşluk Bekçisi'nin Kökeni",
        "content": "Boşluk Bekçisi olarak bilinen varlık bir zamanlar bilinen dünyanın sınırlarını haritalayan bir kartograftu. Bir kenar fazla haritalarken Boşluk onu geri dönmeden önce yakaladı."
      }
    }
  },
